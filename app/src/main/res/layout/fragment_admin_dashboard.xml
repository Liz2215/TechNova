<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard principal del administrador: indicadores del negocio y pedidos recientes -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <TextView
            style="@style/Text.TechNova.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_s"
            android:text="@string/section_business_stats" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include android:id="@+id/statSellers" layout="@layout/layout_stat_card" />

            <include android:id="@+id/statClients" layout="@layout/layout_stat_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include android:id="@+id/statOrders" layout="@layout/layout_stat_card" />

            <include android:id="@+id/statAppStatus" layout="@layout/layout_stat_card" />
        </LinearLayout>

        <TextView
            style="@style/Text.TechNova.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/section_recent_orders" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
