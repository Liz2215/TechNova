<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de producto: imagen, precio, stock, SKU, descripción y garantía -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tn_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.TechNova.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <ImageView
                android:id="@+id/ivProduct"
                android:layout_width="match_parent"
                android:layout_height="@dimen/product_image_detail"
                android:background="@drawable/bg_product_image"
                android:contentDescription="@string/cd_product_image"
                android:padding="@dimen/space_xxl" />

            <TextView
                android:id="@+id/tvName"
                style="@style/Text.TechNova.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRating"
                    style="@style/Text.TechNova.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tn_amber" />

                <TextView
                    android:id="@+id/tvCategory"
                    style="@style/Text.TechNova.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:background="@drawable/bg_badge_info"
                    android:textColor="@color/tn_indigo" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPrice"
                style="@style/Text.TechNova.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textSize="@dimen/text_headline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStock"
                    style="@style/Text.TechNova.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_ok"
                    android:textColor="@color/tn_status_ok" />

                <TextView
                    android:id="@+id/tvSku"
                    style="@style/Text.TechNova.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/space_m" />
            </LinearLayout>

            <TextView
                style="@style/Text.TechNova.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/detail_description" />

            <TextView
                android:id="@+id/tvDescription"
                style="@style/Text.TechNova.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                style="@style/Text.TechNova.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:drawablePadding="@dimen/space_s"
                android:gravity="center_vertical"
                android:text="@string/detail_warranty"
                app:drawableStartCompat="@drawable/ic_check_circle" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior fija con el botón de compra -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tn_surface"
        android:elevation="@dimen/card_elevation"
        android:padding="@dimen/space_l">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCart"
            style="@style/Widget.TechNova.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_cart"
            app:icon="@drawable/ic_cart"
            app:iconGravity="textStart"
            app:iconTint="@color/tn_white" />
    </LinearLayout>
</LinearLayout>
