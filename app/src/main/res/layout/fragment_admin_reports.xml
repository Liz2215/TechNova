<?xml version="1.0" encoding="utf-8"?>
<!-- Reporte de ventas: filtro por período, indicadores, gráfico, más vendidos y ventas por categoría -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <TextView
            style="@style/Text.TechNova.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/reports_title" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_s"
            app:checkedChip="@id/chipWeek"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeek"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_week"
                app:chipBackgroundColor="@color/selector_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMonth"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_month"
                app:chipBackgroundColor="@color/selector_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipYear"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_year"
                app:chipBackgroundColor="@color/selector_chip_bg" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include android:id="@+id/statTotal" layout="@layout/layout_stat_card" />

            <include android:id="@+id/statOrders" layout="@layout/layout_stat_card" />

            <include android:id="@+id/statTicket" layout="@layout/layout_stat_card" />
        </LinearLayout>

        <!-- Gráfico de ventas (se dibuja desde el código) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.TechNova.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_sales_chart" />

                <LinearLayout
                    android:id="@+id/chartBars"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/chartLabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Productos más vendidos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xs">

            <LinearLayout
                android:id="@+id/layoutTopProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.TechNova.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/section_top_products" />
                <!-- Las filas se agregan desde el código con item_top_product -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Participación por categoría -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xs">

            <LinearLayout
                android:id="@+id/layoutCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.TechNova.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:text="@string/section_sales_by_category" />
                <!-- Las filas se agregan desde el código con item_category_progress -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.TechNova.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xs"
            android:text="@string/btn_export_report"
            app:icon="@drawable/ic_report"
            app:iconGravity="textStart"
            app:iconTint="@color/tn_indigo" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
