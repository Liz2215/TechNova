<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="@dimen/logo_size"
                    android:layout_height="@dimen/logo_size"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/cd_avatar"
                    android:padding="@dimen/space_l"
                    android:src="@drawable/ic_person" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tn_white"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tn_mint_light"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/optOrders"
                    style="@style/Widget.TechNova.OptionRow"
                    android:drawableStart="@drawable/ic_orders"
                    android:text="@string/profile_orders" />

                <View style="@style/Widget.TechNova.Divider" />

                <TextView
                    android:id="@+id/optAddresses"
                    style="@style/Widget.TechNova.OptionRow"
                    android:drawableStart="@drawable/ic_shipping"
                    android:text="@string/profile_addresses" />

                <View style="@style/Widget.TechNova.Divider" />

                <TextView
                    android:id="@+id/optPqr"
                    style="@style/Widget.TechNova.OptionRow"
                    android:drawableStart="@drawable/ic_edit"
                    android:text="@string/profile_pqr" />

                <View style="@style/Widget.TechNova.Divider" />

                <TextView
                    android:id="@+id/optPrivacy"
                    style="@style/Widget.TechNova.OptionRow"
                    android:drawableStart="@drawable/ic_check_circle"
                    android:text="@string/profile_privacy" />

                <View style="@style/Widget.TechNova.Divider" />

                <TextView
                    android:id="@+id/optDelete"
                    style="@style/Widget.TechNova.OptionRow"
                    android:drawableStart="@drawable/ic_delete"
                    android:text="@string/profile_delete"
                    android:textColor="@color/tn_status_error" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.TechNova.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_logout" />
    </LinearLayout>
</ScrollView>
