<?xml version="1.0" encoding="utf-8"?>
<!-- Inventario del vendedor con opciones de editar y eliminar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            style="@style/Text.TechNova.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/section_my_products" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/fab_clearance"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_l"
        android:contentDescription="@string/product_form_new"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/tn_mint"
        app:tint="@color/tn_white" />
</FrameLayout>
