<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.TechNova.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="backgroundTint">@color/tn_indigo</item>
        <item name="android:textColor">@color/tn_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TechNova.Button.Accent">
        <item name="backgroundTint">@color/tn_mint</item>
    </style>

    <style name="Widget.TechNova.Button.Small">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/radius_s</item>
    </style>

    <style name="Widget.TechNova.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">@color/tn_indigo</item>
        <item name="android:textColor">@color/tn_indigo</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <style name="Widget.TechNova.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">@color/tn_indigo</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Widget.TechNova.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeColor">@color/tn_indigo</item>
        <item name="hintTextColor">@color/tn_indigo</item>
    </style>

    <style name="Widget.TechNova.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/tn_surface</item>
    </style>

    <style name="Widget.TechNova.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@drawable/bg_toolbar</item>
        <item name="titleTextColor">@color/tn_white</item>
        <item name="subtitleTextColor">@color/tn_indigo_light</item>
        <item name="navigationIconTint">@color/tn_white</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="android:theme">@style/ThemeOverlay.TechNova.Toolbar</item>
    </style>

    <style name="ThemeOverlay.TechNova.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/tn_white</item>
        <item name="colorOnSurface">@color/tn_white</item>
    </style>

    <style name="Widget.TechNova.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/tn_surface</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TechNova.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.TechNova.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/tn_mint_light</item>
    </style>

    <style name="Text.TechNova.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/tn_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.TechNova.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/tn_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.TechNova.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/tn_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.TechNova.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/tn_text_secondary</item>
    </style>

    <style name="Text.TechNova.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/tn_text_secondary</item>
    </style>

    <style name="Text.TechNova.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/tn_coral</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.TechNova.StatValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/tn_indigo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.TechNova.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <style name="Widget.TechNova.OptionRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/tn_text_primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.TechNova.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/tn_text_primary</item>
        <item name="thumbTint">@color/selector_switch_thumb</item>
        <item name="trackTint">@color/selector_switch_track</item>
    </style>

    <style name="ShapeAppearance.TechNova.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="ShapeAppearance.TechNova.PhotoSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>

    <style name="Widget.TechNova.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/stroke_width</item>
        <item name="android:background">@color/tn_divider</item>
    </style>
</resources>
