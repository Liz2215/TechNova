<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TechNova">

        <!-- Autenticación -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.RegisterActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Rol Comprador -->
        <activity android:name=".ui.buyer.BuyerActivity" />
        <activity android:name=".ui.buyer.ProductDetailActivity" />
        <activity android:name=".ui.buyer.CartActivity" />
        <activity android:name=".ui.buyer.CheckoutActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Rol Vendedor -->
        <activity android:name=".ui.seller.SellerActivity" />
        <activity android:name=".ui.seller.ProductFormActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Rol Administrador -->
        <activity android:name=".ui.admin.AdminActivity" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
