rules_version = '2';

// Reglas de seguridad de Cloud Firestore para TechNova.
// Control de acceso por rol (RBAC) validado en el servidor de Firebase:
// BUYER (comprador), SELLER (vendedor) y ADMIN (administrador).
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Hay un usuario con sesión iniciada?
    function signedIn() {
      return request.auth != null;
    }

    // Perfil del usuario que hace la petición.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Rol del usuario que hace la petición (solo si su cuenta está activa).
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true
        ? me().role : 'NONE';
    }

    function isAdmin() { return role() == 'ADMIN'; }
    function isSeller() { return role() == 'SELLER'; }

    // Campos que cambian en una actualización.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Usuarios: cada quien ve y edita su perfil (sin cambiar su rol ni su estado);
    // el administrador gestiona todos. Al registrarse solo se puede ser comprador o vendedor.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role in ['BUYER', 'SELLER']
            && request.resource.data.active == true);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && !changed().hasAny(['role', 'active', 'email']));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Carrito: solo su dueño lo lee y lo modifica.
      match /cart/{productId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Productos: cualquier usuario con sesión los ve. El vendedor crea y gestiona
    // solo los suyos; el administrador, todos. El comprador solo puede descontar stock al comprar.
    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isSeller() && request.resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin()
        || (isSeller() && resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == request.auth.uid)
        || (signedIn() && changed().hasOnly(['stock'])
            && request.resource.data.stock >= 0 && request.resource.data.stock < resource.data.stock);
      allow delete: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    // Pedidos: el comprador crea los suyos y ve su historial; el vendedor ve los pedidos
    // con sus productos y solo puede cambiar el estado; el administrador ve y gestiona todos.
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && resource.data.buyerId == request.auth.uid)
        || (signedIn() && request.auth.uid in resource.data.sellerIds);
      allow update: if isAdmin()
        || (isSeller() && request.auth.uid in resource.data.sellerIds && changed().hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Configuración de la tienda: todos la leen, solo el administrador la cambia.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // PQR: el usuario radica las suyas y las consulta; el administrador las ve todas.
    match /pqrs/{pqrId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
